__pycache__/
*.pyc
.venv/

# Real secrets. server/config.py calls load_dotenv(), so this file is how a
# shell gets the credentials the deployment holds — which means it is where
# a service-account PRIVATE KEY ends up, in a repo where `.env.example` is
# tracked one character away from it. Ignore the real one explicitly and
# un-ignore the example, so adding a key here cannot be staged by `git add -A`.
.env
.env.*
!.env.example

# Local SQLite state. Each box has its own reviews/drafts; committing one
# would overwrite another machine's data on pull, and the journal/WAL
# siblings churn on every write.
local.db
local.db-*
*.sqlite
*.sqlite-*

# Diagnostic output, regenerated on demand.
diagnose_report.txt
demo.db

# Snapshot loop and mutation shard logs. Local scratch: the container has
# rewound repeatedly and /tmp has been cleared mid-run, so these live in the
# repo to survive it — but they are machine output, not source.
.snap/
