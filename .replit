run = "python -m server.main"
entrypoint = "server/main.py"
modules = ["python-3.11", "postgresql-16"]

[nix]
channel = "stable-23_05"
packages = ["libxcrypt"]

[deployment]
run = ["bash", "-c", "PORT=5000 python -m server.main"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 80

[env]
PYTHONPATH = "${REPL_HOME}"
PYTHONUNBUFFERED = "1"

[agent]
expertMode = true

[userenv]

[userenv.shared]
MOCK_MODE = "true"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 python -m server.main"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
