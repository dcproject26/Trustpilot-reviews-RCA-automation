# UVICORN_RELOAD makes the dev server pick up a git pull without a restart.
# Without it, a pull updates the files while the process keeps serving what it
# imported at startup - which cost most of an afternoon of reading correct code
# against output from a build that no longer existed. Deployment below stays
# without reload, which is correct for production.
run = "UVICORN_RELOAD=1 PORT=5000 python -m server.main"
entrypoint = "server/main.py"
modules = ["python-3.11", "nodejs-20", "postgresql-16"]

[nix]
channel = "stable-23_05"
packages = ["libxcrypt"]

[deployment]
run = ["bash", "-c", "PORT=5000 python -m server.main"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80


[env]
PYTHONPATH = "${REPL_HOME}"
PYTHONUNBUFFERED = "1"
# Deployment builds on a Python where user site-packages are disabled, so a
# `pip install --user` (Replit's default package step) fails. Force pip off
# --user so it installs into the writable .pythonlibs instead of a user dir.
PIP_USER = "false"
# The base Python (Nix store) is read-only and already contains some of these
# packages (e.g. requests), so pip's attempt to UNINSTALL the old copy before
# upgrading fails with "Permission denied: /nix/store/.../requests". Ignoring
# already-installed packages makes pip install fresh without touching the
# read-only Nix store.
PIP_IGNORE_INSTALLED = "1"
# This deploy Python has user-site disabled, so pip's default target is the
# read-only Nix store site-packages (install fails with Permission denied on the
# first package). Install with a prefix into the WRITABLE .pythonlibs dir — the
# same location Replit's runtime loads packages from — so every package installs
# there. Prefix (not --target) keeps a normal layout so google.* namespace
# packages resolve correctly.
PIP_PREFIX = "/home/runner/workspace/.pythonlibs"

[agent]
expertMode = true
integrations = ["bigquery:1.0.0", "zendesk:1.0.0", "python_anthropic_ai_integrations:1.0.0"]

[userenv]

[userenv.shared]
MOCK_MODE = "false"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
# This is what the Run button executes - NOT the top-level `run`, which is why
# setting UVICORN_RELOAD there had no effect and /api/version reported
# "reload": false after a restart. With reload on, a git pull is picked up
# within a couple of seconds and no restart is needed at all.
args = "UVICORN_RELOAD=1 PORT=5000 python -m server.main"
waitForPort = 5000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
