# Paste each of these into Replit's Secrets panel (lock icon in sidebar).
# The app runs without all of them — missing ones fall back to mock data.
# Start with MOCK_MODE=true, then add credentials one at a time.

# ── Step 0: Start here ──────────────────────────────────────
MOCK_MODE=true

# ── Step 1: Slack ────────────────────────────────────────────
# Get from api.slack.com/apps → your app
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-
SLACK_USER_TOKEN=xoxp-
# Right-click channel in Slack → Copy link → last segment
SLACK_CHANNEL_ORM=
SLACK_CHANNEL_ALERT=
# Trustpilot bot ID — click the Trustpilot app in Slack → View app details → Member ID
# Starts with U or B. More reliable than star-symbol detection. Set this now that you've added it.
TRUSTPILOT_BOT_USER_ID=

# ── Step 2: BigQuery ─────────────────────────────────────────
# Paste the full service account JSON as one line
GCP_SERVICE_ACCOUNT_JSON=
BIGQUERY_BOOKINGS_TABLE=headout-prod.analytics.bookings

# ── Step 3: Zendesk ──────────────────────────────────────────
ZENDESK_SUBDOMAIN=headout
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
# Admin Center → Tickets → Fields → Booking ID field → numeric ID in URL
ZENDESK_BOOKING_FIELD_ID=

# ── Step 4: Retool DSS ───────────────────────────────────────
DSS_WEBHOOK_URL=

# ── Step 5: Canned responses ─────────────────────────────────
# Google Sheet ID from the URL: docs.google.com/spreadsheets/d/SHEET_ID/
CANNED_RESPONSES_SHEET_ID=

# ── Database (auto-injected by Replit Postgres — don't touch) ─
# DATABASE_URL=

# ── AI: NO KEY NEEDED ────────────────────────────────────────
# Claude runs via Replit AI Integrations (already enabled in your org).
# Anthropic is toggled ON in your workspace settings. Nothing to add here.
