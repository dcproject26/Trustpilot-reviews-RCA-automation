# Paste each into Replit's Secrets panel (lock icon in sidebar).
# The app runs without all of them — missing ones fall back to mock data.
# MOCK_MODE=true runs against fixtures and blocks Slack posts. Leave it
# false unless you are deliberately testing offline - a stray true in
# Replit Secrets silently disables every integration, and the app looks
# healthy while doing nothing.

# ── Step 0: Start here ────────────────────────────────────────────────────────
# Set true ONLY to run offline against fixtures.
MOCK_MODE=false

# ── Step 1: Slack ─────────────────────────────────────────────────────────────
# Signing Secret + Bot Token from api.slack.com/apps
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-
# User token — needed to post RCA to thread as an associate
SLACK_USER_TOKEN=xoxp-
# Right-click channel → Copy link → last segment (starts with C)
SLACK_CHANNEL_ORM=CAB4TQ2AJ
SLACK_CHANNEL_ALERT=
# Trustpilot bot ID — confirmed from Slack workspace: BRS4EC8KT
TRUSTPILOT_BOT_USER_ID=BRS4EC8KT

# ── Step 2: BigQuery ──────────────────────────────────────────────────────────
# Paste the full GCP service account JSON as one line
GCP_SERVICE_ACCOUNT_JSON=
# Confirmed real table paths from Retool workflow:
BIGQUERY_BOOKINGS_TABLE=headout-analytics.analytics_reporting.fct_bookings
BIGQUERY_REVIEWS_TABLE=headout-analytics.analytics_reporting.fct_reviews
BIGQUERY_FULFILMENTS_TABLE=headout-analytics.analytics_reporting.fct_fulfilments

# ── Step 3: Zendesk ───────────────────────────────────────────────────────────
ZENDESK_SUBDOMAIN=headout
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
# Confirmed booking ID field from Retool workflow:
ZENDESK_BOOKING_FIELD_ID=360021524471

# ── Step 4: Google Apps Script (Zendesk comment fetcher) ─────────────────────
# This endpoint fetches comments for multiple ZD tickets in one call.
# Already deployed — no changes needed unless your team redeploys it.
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbyfYMqIcsihcxRVBAznpyrXtyZMvlITCDpPB7Uarc_cMz8mWgCCbg_O9WZQMJeFjCFqOA/exec

# ── Step 5: Retool DSS ────────────────────────────────────────────────────────
DSS_WEBHOOK_URL=

# ── Step 6: Canned responses Sheet ───────────────────────────────────────────
# OPTIONAL. The approved macros are checked in at server/data/canned_macros.json
# and that is the source of truth — set this only if you want the pipeline to
# prefer a live sheet when it can reach one. Reading it needs the sheet shared
# with the GCP service account; the public CSV export can only see the FIRST of
# its nine tabs, which is not enough (the tabs are split by channel).
#
# Refresh the checked-in copy with:
#     File > Download > Web page (.html), then
#     python3 tools/import_macros.py <the .zip>
#
# This line used to claim "if unavailable, the app uses the 10 embedded
# scenarios in prompts.py". There were none. Every reply was drafted with no
# tone reference at all, and nothing on screen said so.
# CANNED_RESPONSES_SHEET_ID=

# ── Database (auto-injected by Replit Postgres — do not set manually) ─────────
# DATABASE_URL=

# ── AI: NO KEY NEEDED ─────────────────────────────────────────────────────────
# Claude runs via Replit AI Integrations (Anthropic toggle confirmed ON).
